#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "$0")/.."
export HF_HOME="$PWD/work/huggingface"
export HF_HUB_DISABLE_TELEMETRY=1
export LD_LIBRARY_PATH="$(.venv/bin/python -c 'import pathlib,site; p=pathlib.Path(site.getsitepackages()[0])/"nvidia"; print(":".join(str(d) for d in sorted(p.glob("*/lib"))))')${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec .venv/bin/python "$@"
