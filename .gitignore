# Publish source only. Private and generated files are excluded by default.
/*
!/.gitignore
!/README.md
!/requirements.in
!/requirements.lock
!/requirements-diarize.in
!/requirements-diarize.lock
!/scripts/
/scripts/*
!/scripts/*.py
!/scripts/*.ps1
!/scripts/*.sh
!/scripts/run-python
!/scripts/run-diarization-python
/scripts/run_glossary_trial.py
!/tests/
/tests/*
!/tests/test_*.py
/tests/test_glossary_trial.py
!/examples/
/examples/*
!/examples/llm_config.example.json
!/examples/glossary.example.json

# Recordings, conversations, credentials, local state, and model weights.
**/audio/
**/video/
**/transcripts/
**/references/
**/work/
**/recap.md
**/AGENTS.md
**/.env
**/.env.*
**/.venv*/
**/__pycache__/
